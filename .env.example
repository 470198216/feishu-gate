# 从飞书开放平台「凭证与基础信息」复制，不要提交仓库
FEISHU_APP_ID=cli_xxxxxxxx
FEISHU_APP_SECRET=xxxxxxxx

# echo = 原样回一句（先证明通道）
# jobs = 入队；问通不通会查拓扑
FEISHU_MODE=jobs

# 拓扑心跳服务（麒麟现场默认 8080）
TOPOLOGY_STATUS_URL=http://192.168.1.107:8080/api/status

# 可选：只处理这些 open_id。留空则接受所有人（仅限你自己用时可以空）
FEISHU_ALLOW_OPEN_IDS=

# 写入工人。不填 CURSOR_API_KEY 时会尝试读 ../cursor-lan/.env
CURSOR_API_KEY=
CURSOR_MODEL=composer-2.5
WRITE_CWD=C:\Users\wenjin\Desktop\wwjfiles\演示方案讨论\topology-heartbeat-viewer
